  const rows = Math.ceil(n / cols);
  const cellW = Math.min(118, w / (cols + 1)), cellH = Math.min(118, h / (rows + 1));
  const blockW = cellW * cols, blockH = cellH * rows;
  const startX = w/2 - blockW/2 + cellW/2, startY = h/2 - blockH/2 + cellH/2;
  const pts = [];
  for (let i = 0; i < n; i++) { const col = i % cols, row = Math.floor(i / cols); pts.push({ x: startX + col*cellW, y: startY + row*cellH }); }
