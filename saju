<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>대기실 · A.FECT SAJU</title>
<style>
  :root{
    --paper:#F6F2EA; --card:#FFFDF8; --ink:#221F1A; --ink-soft:#6B655B; --ink-faint:#A39C8E;
    --line:rgba(34,31,26,0.10); --accent:#3E3856; --accent-soft:#ECE9F3;
    --wood:#2FA84F; --wood-bg:#DFF3E3; --fire:#FF4136; --fire-bg:#FFE1DE;
    --earth:#E0A526; --earth-bg:#FBEECB; --metal:#7B61FF; --metal-bg:#E9E3FF;
    --water:#0074D9; --water-bg:#DCEBFA; --radius-lg:22px;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--paper); color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif;
    -webkit-font-smoothing:antialiased; }
  .wrap{ max-width:520px; margin:0 auto; padding:36px 20px 80px; text-align:center; }
  @media (min-width: 860px){ .wrap{ max-width:880px; } }

  .brand{ text-align:center; margin-bottom:24px; }
  .brand .mark{ font-size:14px; font-weight:700; letter-spacing:0.14em; color:var(--ink-faint); }

  .pagehead h1{ font-size:30px; font-weight:800; margin:0 0 6px; letter-spacing:-0.01em; }
  .pagehead .subcopy{ font-size:14.5px; color:var(--ink-soft); margin:0 0 26px; }

  .typetabs{ display:flex; gap:8px; overflow-x:auto; padding-bottom:2px; margin-bottom:10px; justify-content:center; scrollbar-width:none; }
  .typetabs::-webkit-scrollbar{ display:none; }
  .typetab{ flex:0 0 auto; padding:10px 18px; border-radius:999px; font-size:14px; font-weight:700;
    background:#fff; border:1px solid var(--line); color:var(--ink-soft); cursor:pointer; white-space:nowrap; }
  .typetab.active{ background:var(--accent); border-color:var(--accent); color:#fff; }
  .typetab.active[data-elem="목"]{ background:var(--wood); border-color:var(--wood); }
  .typetab.active[data-elem="화"]{ background:var(--fire); border-color:var(--fire); }
  .typetab.active[data-elem="토"]{ background:var(--earth); border-color:var(--earth); }
  .typetab.active[data-elem="금"]{ background:var(--metal); border-color:var(--metal); }
  .typetab.active[data-elem="수"]{ background:var(--water); border-color:var(--water); }

  .subtypetabs{ display:none; gap:8px; margin-bottom:10px; justify-content:center; }
  .subtypetabs.show{ display:flex; }
  .subtypetab{ flex:0 0 auto; padding:8px 14px; border-radius:999px; font-size:13px; font-weight:700;
    background:var(--card); border:1px solid var(--line); color:var(--ink-soft); cursor:pointer; }
  .subtypetab.active{ border-color:var(--accent); color:var(--accent); background:var(--accent-soft); }

  .typecaption{ font-size:13.5px; color:var(--ink-soft); margin:0 0 18px; min-height:19px; }

  .lobbyStage{ position:relative; width:100%; height:460px; margin-bottom:16px;
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; }
  @media (min-width:860px){ .lobbyStage{ height:520px; } }
  .lobby-empty-msg{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    text-align:center; color:var(--ink-faint); font-size:13.5px; line-height:1.7; }
  .lobby-avatar{ position:absolute; width:104px; margin-left:-52px; margin-top:-52px;
    display:flex; flex-direction:column; align-items:center; cursor:pointer; user-select:none;
    transition:left 420ms cubic-bezier(0.22,1,0.36,1), top 420ms cubic-bezier(0.22,1,0.36,1), opacity 300ms ease, transform 200ms ease; }
  .lobby-avatar .av-circle{ width:82px; height:82px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:40px; position:relative; box-shadow:0 2px 8px rgba(34,31,26,0.08); }
  .lobby-avatar .av-name{ font-size:15.5px; font-weight:700; margin-top:7px; text-align:center; }
  .lobby-avatar .av-type{ font-size:12.5px; color:var(--ink-faint); text-align:center; }
  .lobby-avatar.selected .av-circle{ box-shadow:0 0 0 3px var(--accent), 0 2px 8px rgba(34,31,26,0.12); transform:scale(1.08); }
  .lobby-avatar .av-check{ position:absolute; top:-2px; right:-2px; width:22px; height:22px; border-radius:50%;
    background:var(--accent); color:#fff; font-size:12px; display:none; align-items:center; justify-content:center; border:2px solid var(--card); }
  .lobby-avatar.selected .av-check{ display:flex; }
  .lobby-avatar.dimmed{ opacity:0.25; }

  .joinRow{ display:flex; justify-content:center; margin-bottom:20px; }
  .joinBtnPill{ padding:12px 22px; border-radius:999px; background:#fff; border:1.5px dashed var(--ink-faint);
    color:var(--ink-soft); font-size:13.5px; font-weight:700; font-family:inherit; cursor:pointer; }

  .selectRow{ display:flex; justify-content:center; gap:8px; margin-bottom:22px; flex-wrap:wrap; }
  .selectBtn{ padding:9px 16px; border-radius:999px; background:#fff; border:1px solid var(--line);
    color:var(--ink-soft); font-size:12.5px; font-weight:700; font-family:inherit; cursor:pointer; }
  .selectBtn.primary{ background:var(--accent-soft); border-color:var(--accent); color:var(--accent); }

  .playbar{ margin-bottom:8px; }
  .selectioninfo{ font-size:14px; font-weight:700; color:var(--ink-soft); margin-bottom:14px; min-height:18px; }
  .playtabs{ display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding-bottom:4px; justify-content:center; flex-wrap:wrap; }
  .playtabs::-webkit-scrollbar{ display:none; }
  .playtab{ flex:0 0 auto; padding:12px 18px; border-radius:16px; font-size:13.5px; font-weight:700;
    background:#fff; border:1px solid var(--line); color:var(--ink); cursor:pointer; white-space:nowrap; }
  .playtab.active{ background:var(--ink); border-color:var(--ink); color:#fff; }
  .playtab.disabled{ opacity:0.45; }
  .playtoast{ font-size:12.5px; color:var(--ink-faint); margin-top:10px; display:none; }

  #playResult{ display:none; margin-top:40px; text-align:center; }
  .resulthead h2{ font-size:22px; font-weight:800; margin:0 0 8px; line-height:1.4; }
  .resulthead .lede{ font-size:13.5px; color:var(--ink-faint); margin:0 0 30px; }

  .capchiprow{ display:flex; justify-content:center; gap:8px; margin-bottom:20px; }
  .capchip{ padding:10px 18px; border-radius:12px; font-size:13px; font-weight:700; background:#fff;
    border:1px solid var(--line); color:var(--ink-soft); cursor:pointer; }
  .capchip.active{ border-color:var(--accent); background:var(--accent-soft); color:var(--accent); }

  .seatsubtabs{ display:flex; gap:8px; margin-bottom:26px; justify-content:center; }
  .seatsubtab{ padding:13px 20px; border-radius:14px; font-size:13.5px; font-weight:700;
    background:#fff; border:1px solid var(--line); color:var(--ink-soft); cursor:pointer; }
  .seatsubtab.active{ border-color:var(--accent); background:var(--accent-soft); color:var(--accent); }

  .tables-grid{ display:grid; grid-template-columns:1fr; gap:48px 32px; justify-items:center; }
  @media (min-width:860px){ .tables-grid{ grid-template-columns:1fr 1fr; gap:56px 40px; } }
  .table-card{ padding:28px 24px; background:var(--card); border:1px solid var(--line); border-radius:20px; }
  .tablabel{ text-align:center; font-size:12.5px; font-weight:700; color:var(--ink-soft); margin-bottom:16px; }

  .tablewrap{ position:relative; margin:0 auto; }
  .table-rect{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); border-radius:16px; background:var(--paper); }
  .seat-node{ position:absolute; display:flex; flex-direction:column; align-items:center; z-index:3; }
  .seat-node .circle{ border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 6px rgba(34,31,26,0.08); }
  .seat-node .label{ font-weight:700; margin-top:6px; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .seat-node .typecap{ color:var(--ink-faint); text-align:center; }

  .connector-hit{ pointer-events:stroke; cursor:pointer; }
  .connector-dot{ cursor:pointer; animation:dotpulse 2.6s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  .connector-group:hover .connector-visible{ stroke:var(--accent) !important; stroke-width:3 !important; }
  .connector-group:hover .connector-dot{ fill:var(--accent) !important; animation:none; }
  @keyframes dotpulse{ 0%,100%{ opacity:0.55; } 50%{ opacity:1; } }

  .teambalance-below{ max-width:240px; margin:24px auto 0; text-align:center; }
  .teambalance-below .tblabel{ font-size:10.5px; font-weight:700; color:var(--ink-faint); letter-spacing:0.04em; margin-bottom:8px; }
  .teambalance-below .tbar{ display:flex; height:8px; border-radius:999px; overflow:hidden; margin-bottom:7px; }
  .teambalance-below .tbar span{ height:100%; }
  .teambalance-below .tnote{ font-size:10.5px; color:var(--ink-faint); line-height:1.5; }

  .pair-tooltip{ position:absolute; z-index:6; width:280px; background:var(--card); color:var(--ink);
    border:1px solid var(--line); border-radius:16px; padding:22px 24px; display:none; text-align:left;
    box-shadow:0 14px 32px rgba(34,31,26,0.16); pointer-events:none; }
  @media (min-width:860px){ .pair-tooltip{ width:380px; padding:24px; } }
  .pair-tooltip .tt-names{ font-size:12.5px; font-weight:700; color:var(--ink-faint); margin-bottom:10px; }
  .pair-tooltip .tt-headline{ font-size:16.5px; font-weight:700; line-height:1.5; margin-bottom:14px; }
  .pair-tooltip .tt-summary{ font-size:14.5px; color:var(--ink-soft); line-height:1.7; margin-bottom:14px; }
  .pair-tooltip .tt-evidence{ font-size:13.5px; color:var(--ink-faint); line-height:1.7; border-top:1px solid var(--line); padding-top:12px; }

  /* ---- chemi / lunch / recharge / group result cards ---- */
  .chemihead{ display:flex; align-items:center; justify-content:center; gap:18px; margin-bottom:18px; flex-wrap:wrap; }
  .chemihead .chip{ display:flex; align-items:center; gap:8px; font-size:15px; font-weight:700; }
  .chemihead .em{ font-size:30px; }
  .scoreBig{ font-size:52px; font-weight:800; color:var(--accent); line-height:1; margin-bottom:4px; }
  .scoreLabel{ font-size:12.5px; color:var(--ink-faint); font-weight:700; letter-spacing:0.04em; margin-bottom:26px; }
  .resultcard{ max-width:440px; margin:0 auto 28px; background:var(--card); border:1px solid var(--line);
    border-radius:20px; padding:28px 26px; text-align:left; }
  .resultcard .rheadline{ font-size:17px; font-weight:700; line-height:1.55; margin-bottom:12px; }
  .resultcard .rbody{ font-size:14.5px; color:var(--ink-soft); line-height:1.7; margin-bottom:14px; }
  .rtoggle{ font-size:12.5px; color:var(--accent); font-weight:700; cursor:pointer; display:inline-block; }
  .rdetail{ display:none; font-size:13px; color:var(--ink-faint); line-height:1.7; margin-top:12px; padding-top:12px; border-top:1px solid var(--line); }

  .subscoregrid{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; max-width:440px; margin:0 auto 28px; }
  @media (min-width:640px){ .subscoregrid{ grid-template-columns:repeat(3,1fr); } }
  .subscorecard{ background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px 12px; text-align:center; }
  .subscorecard .em{ font-size:24px; margin-bottom:6px; }
  .subscorecard .val{ font-size:22px; font-weight:800; color:var(--ink); }
  .subscorecard .cap{ font-size:11.5px; color:var(--ink-faint); font-weight:700; margin-bottom:4px; }
  .subscorecard .line{ font-size:11.5px; color:var(--ink-soft); line-height:1.5; margin-top:6px; }

  .roleGrid{ display:flex; flex-direction:column; gap:10px; max-width:440px; margin:0 auto 26px; }
  .roleRow{ display:flex; align-items:center; gap:14px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px 16px; text-align:left; }
  .roleRow .em{ font-size:26px; }
  .roleRow .nm{ font-weight:700; font-size:14px; }
  .roleRow .rl{ font-size:12.5px; color:var(--ink-soft); }

  .luckycard{ max-width:400px; margin:0 auto 26px; background:var(--card); border:1px solid var(--line);
    border-radius:20px; padding:26px; text-align:center; }
  .luckycard .needchips{ display:flex; justify-content:center; gap:8px; margin-bottom:16px; }
  .luckychip{ font-size:12.5px; font-weight:700; padding:6px 12px; border-radius:999px; }
  .luckycard .itemname{ font-size:19px; font-weight:800; margin-bottom:10px; }
  .luckycard .itemcopy{ font-size:14px; color:var(--ink-soft); line-height:1.7; }

  .nextactions{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:8px; }
  .nextbtn{ padding:11px 18px; border-radius:999px; background:#fff; border:1px solid var(--line);
    color:var(--ink); font-size:13px; font-weight:700; font-family:inherit; cursor:pointer; }

  .lunchlist{ display:flex; flex-direction:column; gap:10px; max-width:440px; margin:0 auto 24px; }
  .lunchrow{ display:flex; align-items:center; gap:12px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px 16px; text-align:left; }
  .lunchrow .em{ font-size:24px; }
  .lunchrow .nm{ font-weight:700; font-size:13.5px; }
  .lunchrow .tag{ font-size:12px; color:var(--ink-soft); }

  /* ---- entry overlay ---- */
  .overlay{ position:fixed; inset:0; background:rgba(34,31,26,0.45); z-index:20; display:flex; align-items:flex-end; justify-content:center; }
  @media (min-width:640px){ .overlay{ align-items:center; } }
  .entrycard{ width:100%; max-width:440px; max-height:88vh; overflow-y:auto; background:var(--card);
    border-radius:24px 24px 0 0; padding:28px 24px 32px; text-align:left; }
  @media (min-width:640px){ .entrycard{ border-radius:24px; } }
  .entrycard h2{ font-size:20px; font-weight:800; margin:0 0 6px; }
  .entrycard .lede{ font-size:13.5px; color:var(--ink-soft); margin:0 0 22px; }
  .field{ margin-bottom:22px; }
  .field label{ display:block; font-size:13px; font-weight:700; color:var(--ink-soft); margin-bottom:8px; }
  .field input[type="text"], .field input[type="number"], .field select{
    width:100%; height:46px; padding:0 13px; font-size:15px; border:1px solid var(--line);
    border-radius:10px; background:#fff; color:var(--ink); font-family:inherit;
    box-sizing:border-box; appearance:none; -moz-appearance:textfield; -webkit-appearance:none; }
  .field input[type="number"]::-webkit-inner-spin-button, .field input[type="number"]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }
  .field select{ background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B655B' stroke-width='2'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat:no-repeat; background-position:right 12px center; background-size:16px; }
  .field select:disabled{ opacity:0.45; background-color:var(--paper); }
  .dategrid{ display:flex; gap:8px; }
  .dategrid input#mYear{ flex:1.4; } .dategrid input#mMonth, .dategrid input#mDay{ flex:1; }
  .unknown-time{ display:flex; align-items:center; gap:7px; font-size:12px; color:var(--ink-soft); margin-top:-8px; margin-bottom:20px; cursor:pointer; }
  .unknown-time input{ margin:0; }
  .err{ font-size:12px; color:var(--fire); margin-top:6px; margin-bottom:14px; display:none; }
  .cta{ width:100%; padding:14px; background:var(--accent); color:#fff; border:none; border-radius:12px; font-size:15px; font-weight:700; font-family:inherit; cursor:pointer; }
  .ghost-btn{ width:100%; padding:12px; background:transparent; color:var(--ink-soft); border:1px solid var(--line);
    border-radius:12px; font-size:14px; font-weight:700; font-family:inherit; cursor:pointer; margin-top:8px; }
</style>
</head>
<body>
<div class="wrap">

  <div class="brand"><div class="mark">A.FECT SAJU</div></div>

  <div class="pagehead">
    <h1>대기실</h1>
    <p class="subcopy" id="lobbySubcopy">오늘도 다들 먼저 와 있습니다.</p>
  </div>

  <div class="typetabs" id="typeTabs"></div>
  <div class="subtypetabs" id="subTypeTabs"></div>
  <p class="typecaption" id="typeCaption"></p>

  <div class="lobbyStage" id="lobbyStage">
    <div class="lobby-empty-msg" id="lobbyEmptyMsg">아직 아무도 없어요.<br>아래에서 첫 멤버로 참여해 보세요.</div>
  </div>

  <div class="joinRow"><button class="joinBtnPill" id="joinBtn">+ 새 멤버 참여시키기</button></div>

  <div class="selectRow">
    <button class="selectBtn primary" id="selectAllBtn">전체 선택</button>
    <button class="selectBtn" id="selectTypeBtn" style="display:none;">이 타입만 선택</button>
    <button class="selectBtn" id="deselectBtn">선택 해제</button>
  </div>

  <div class="playbar">
    <div class="selectioninfo" id="selectionInfo"></div>
    <div class="playtabs" id="playTabs"></div>
    <div class="playtoast" id="playToast"></div>
  </div>

  <div id="playResult"></div>

  <div class="overlay" id="entryOverlay" style="display:none;">
    <div class="entrycard">
      <h2>참여하기</h2>
      <p class="lede">본인 정보를 입력해 주세요.</p>
      <div class="field"><label for="mNick">닉네임</label><input type="text" id="mNick" placeholder="예: 점머씨"></div>
      <div class="field"><label>생년월일</label>
        <div class="dategrid">
          <input type="number" id="mYear" placeholder="년(4자리)" inputmode="numeric">
          <input type="number" id="mMonth" placeholder="월" inputmode="numeric">
          <input type="number" id="mDay" placeholder="일" inputmode="numeric">
        </div>
      </div>
      <div class="field"><label for="mHour">태어난 시각 (시주)</label>
        <select id="mHour"><option value="" disabled selected>시간을 선택해 주세요</option></select>
      </div>
      <label class="unknown-time"><input type="checkbox" id="mUnknown"> 태어난 시각을 몰라요</label>
      <div class="err" id="addErr"></div>
      <button class="cta" id="submitEntryBtn">참여 완료</button>
      <button class="ghost-btn" id="cancelEntryBtn">취소</button>
    </div>
  </div>

</div>

<script>
// ================= Saju engine (검증된 기존 로직 재사용) =================
const STEMS = ['갑','을','병','정','무','기','경','신','임','계'];
const STEM_HANJA = ['甲','乙','丙','丁','戊','己','庚','辛','壬','癸'];
const BRANCHES = ['자','축','인','묘','진','사','오','미','신','유','술','해'];
const STEM_ELEM = ['목','목','화','화','토','토','금','금','수','수'];
const ZODIAC_EMOJI = ['🐭','🐮','🐯','🐰','🐲','🐍','🐴','🐑','🐵','🐔','🐶','🐷'];
const ELEM_EMOJI = { '목':'🌳','화':'🔥','토':'🪨','금':'⚙️','수':'💧' };
const ELEM_HANJA = { '목':'木','화':'火','토':'土','금':'金','수':'水' };
const ELEM_COLOR = { '목':'var(--wood)', '화':'var(--fire)', '토':'var(--earth)', '금':'var(--metal)', '수':'var(--water)' };
const ELEM_BG = { '목':'var(--wood-bg)', '화':'var(--fire-bg)', '토':'var(--earth-bg)', '금':'var(--metal-bg)', '수':'var(--water-bg)' };
const GENERATES = {'목':'화','화':'토','토':'금','금':'수','수':'목'};
const CONTROLS = {'목':'토','토':'수','수':'화','화':'금','금':'목'};

function jdn(y, m, d) {
  const a = Math.floor((14 - m) / 12);
  const y2 = y + 4800 - a;
  const m2 = m + 12 * a - 3;
  return d + Math.floor((153 * m2 + 2) / 5) + 365 * y2 + Math.floor(y2 / 4) - Math.floor(y2 / 100) + Math.floor(y2 / 400) - 32045;
}
function dayPillar(y, m, d) { const j = jdn(y, m, d); return { stemIdx: (j + 9) % 10, branchIdx: (j + 1) % 12 }; }
function toJulianDay(y, m, d, hourFrac) { return jdn(y, m, d) - 0.5 + hourFrac / 24; }
function solarLongitude(jd) {
  const T = (jd - 2451545.0) / 36525;
  const L0 = 280.46646 + 36000.76983 * T + 0.0003032 * T * T;
  const M = 357.52911 + 35999.05029 * T - 0.0001537 * T * T;
  const Mrad = M * Math.PI / 180;
  const C = (1.914602 - 0.004817 * T - 0.000014 * T * T) * Math.sin(Mrad) + (0.019993 - 0.000101 * T) * Math.sin(2 * Mrad) + 0.000289 * Math.sin(3 * Mrad);
  let lon = (L0 + C) % 360; if (lon < 0) lon += 360; return lon;
}
function findSolarTermJD(year, approxMonth, targetDeg) {
  let lo = jdn(year, approxMonth, 1) - 20, hi = jdn(year, approxMonth, 1) + 45;
  function angDiff(jd) { let diff = solarLongitude(jd) - targetDeg; if (diff > 180) diff -= 360; if (diff < -180) diff += 360; return diff; }
