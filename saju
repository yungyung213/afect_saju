function compatibilityScore(a, b) {
  const elemA = STEM_ELEM[a.saju.day.stemIdx], elemB = STEM_ELEM[b.saju.day.stemIdx];
  const rel = relOf(elemA, elemB);
  let score = 65;
  if (rel==='a-gen-b'||rel==='b-gen-a') score += 18;
  else if (rel==='same') score += 10;
  else if (rel==='a-ctl-b'||rel==='b-ctl-a') score += 6;
  else score += 12;
  if (b.counts[weakestElem(a.counts)] > 0) score += 6;
  if (a.counts[weakestElem(b.counts)] > 0) score += 6;
  if (a.saju.day.stemIdx === b.saju.day.stemIdx) score -= 4;
  return clamp(score);
}
function subScores(a, b) {
  const elemA = STEM_ELEM[a.saju.day.stemIdx], elemB = STEM_ELEM[b.saju.day.stemIdx];
  const rel = relOf(elemA, elemB);
  const ta = TEMPERAMENT[elemA], tb = TEMPERAMENT[elemB];
  const complement = (ta==='init'&&tb==='ground')||(ta==='ground'&&tb==='init');
  const sameTemp = ta===tb;
  const gen = rel==='a-gen-b'||rel==='b-gen-a', ctl = rel==='a-ctl-b'||rel==='b-ctl-a';
  const idea = clamp(70 + (complement?20:0) + (sameTemp?-8:0) + (gen?6:0));
  const work = clamp(66 + (gen?20:0) + (b.counts[weakestElem(a.counts)]>0?6:0) + (a.counts[weakestElem(b.counts)]>0?6:0));
  const lunch = clamp(76 + (elemA===elemB?18:8));
  const talk = clamp(68 + (gen?20: rel==='same'?14:8));
  const peace = clamp(90 - (ctl?24:0));
  return { idea, work, lunch, talk, peace };
