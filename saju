function pairScoreElem(a, b) {
  const ea = STEM_ELEM[a.saju.day.stemIdx], eb = STEM_ELEM[b.saju.day.stemIdx];
  let score = 0;
  if (b.counts[weakestElem(a.counts)] > 0) score += 2;
  if (a.counts[weakestElem(b.counts)] > 0) score += 2;
  if (ea !== eb) score += 1;
  if (a.saju.day.stemIdx === b.saju.day.stemIdx) score -= 3;
  return score;
}
function pairScoreIlgan(a, b) {
  const rel = relOf(STEM_ELEM[a.saju.day.stemIdx], STEM_ELEM[b.saju.day.stemIdx]);
  if (rel === 'a-gen-b' || rel === 'b-gen-a') return 4;
  if (rel === 'same') return 2;
  if (rel === 'a-ctl-b' || rel === 'b-ctl-a') return -2;
  return 0;
}
const MODE_SCORERS = { 'oksudong-elem':pairScoreElem, 'oksudong-ilgan':pairScoreIlgan };
const MODE_INFO = {
  'oksudong-elem': { title:'옥수동 뉴 사무실 자리배치 · 오행', lede:'오행 밸런스를 기준으로 서로 부족한 기운을 채워주는 조합.' },
  'oksudong-ilgan': { title:'옥수동 뉴 사무실 자리배치 · 일간', lede:'일간(예: 기토, 정화)끼리의 상생·상극 관계를 기준으로 짠 조합.' },
};
function scoreArrangement(order, mode) {
  if (order.length < 2) return 0;
  const fn = MODE_SCORERS[mode]; let total = 0;
  for (let i = 0; i < order.length; i++) total += fn(order[i], order[(i+1) % order.length]);
  return total;
}
function permute(arr) {
  if (arr.length <= 1) return [arr];
  const result = [];
  for (let i = 0; i < arr.length; i++) { const rest = arr.slice(0,i).concat(arr.slice(i+1)); permute(rest).forEach(p => result.push([arr[i], ...p])); }
  return result;
}
function bestArrangement(list, mode) {
  if (list.length <= 1) return list;
  const first = list[0]; const perms = permute(list.slice(1));
  let best = null, bestScore = -Infinity;
  perms.forEach(p=>{ const order = [first, ...p]; const s = scoreArrangement(order, mode); if (s > bestScore) { bestScore = s; best = order; } });
  return best;
}
function splitIntoTables(list, capacity) {
  const numTables = Math.max(1, Math.ceil(list.length / capacity));
  const base = Math.floor(list.length / numTables), remainder = list.length % numTables;
  const groups = []; let idx = 0;
  for (let t = 0; t < numTables; t++) { const count = base + (t < remainder ? 1 : 0); groups.push(list.slice(idx, idx + count)); idx += count; }
  return groups;
}
function getGeo() { return { seatSlot:118, tableWidth:220, tableHeight:66, seatRowGap:74, sidePad:60, circleD:64 }; }
function layoutToGrid(order, geo) {
  const n = order.length;
  const topCount = Math.ceil(n / 2), bottomCount = n - topCount;
  const topMembers = order.slice(0, topCount), bottomMembers = order.slice(topCount).reverse();
  const maxCount = Math.max(topCount, bottomCount, 1);
  const rowSpread = (maxCount - 1) * geo.seatSlot;
  const boxWidth = Math.max(rowSpread, geo.tableWidth) + geo.sidePad * 2;
  const boxHeight = geo.tableHeight + geo.seatRowGap * 2 + 56;
  const cx = boxWidth / 2, cy = boxHeight / 2;
  function rowX(i, count) { if (count === 0) return cx; const start = cx - ((count - 1) / 2) * geo.seatSlot; return start + i * geo.seatSlot; }
  const topY = cy - geo.tableHeight/2 - geo.seatRowGap, bottomY = cy + geo.tableHeight/2 + geo.seatRowGap;
  const topPos = topMembers.map((mem,i)=> ({ mem, x: rowX(i, topCount), y: topY }));
  const bottomPos = bottomMembers.map((mem,i)=> ({ mem, x: rowX(i, bottomCount), y: bottomY }));
  return { topPos, bottomPos, boxWidth, boxHeight, tableWidth: geo.tableWidth, tableHeight: geo.tableHeight, cx, cy };
}
function buildGridConnectors(topPos, bottomPos) {
  const list = [];
  for (let i = 0; i < topPos.length - 1; i++) list.push([topPos[i], topPos[i+1]]);
  for (let i = 0; i < bottomPos.length - 1; i++) list.push([bottomPos[i], bottomPos[i+1]]);
  const n = topPos.length + bottomPos.length;
  if (topPos.length && bottomPos.length) {
    if (n === 2) list.push([topPos[0], bottomPos[0]]);
    else { list.push([topPos[topPos.length-1], bottomPos[bottomPos.length-1]]); list.push([bottomPos[0], topPos[0]]); }
  }
  return list;
}

