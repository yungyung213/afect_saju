function buildPairExplanation(memA, memB) {
  const elemA = STEM_ELEM[memA.saju.day.stemIdx], elemB = STEM_ELEM[memB.saju.day.stemIdx];
  const glyphA = STEMS[memA.saju.day.stemIdx]+elemA, glyphB = STEMS[memB.saju.day.stemIdx]+elemB;
  const rel = relOf(elemA, elemB);
  const weakA = weakestElem(memA.counts), weakB = weakestElem(memB.counts);
  const fillsA = memB.counts[weakA] > 0, fillsB = memA.counts[weakB] > 0;
  let headline, summary, evidence;
  if (rel === 'a-gen-b' || rel === 'b-gen-a') {
    const giver = rel==='a-gen-b' ? memA : memB, getter = rel==='a-gen-b' ? memB : memA;
    const giverElem = rel==='a-gen-b' ? elemA : elemB, getterElem = rel==='a-gen-b' ? elemB : elemA;
    const giverGlyph = rel==='a-gen-b' ? glyphA : glyphB, getterGlyph = rel==='a-gen-b' ? glyphB : glyphA;
    headline = pick(GEN_HEADLINES)({ giver: giver.nickname, getter: getter.nickname });
    summary = `${giver.nickname}님은 방향을 넓히고, ${getter.nickname}님은 그걸 실행 가능한 선으로 정리하는 역할을 하기 쉬워요.`;
    evidence = `${giver.nickname}(${giverGlyph}) → ${getter.nickname}(${getterGlyph}) : ${giverElem}이 ${getterElem}을 생(生)하는 관계.`;
  } else if (rel === 'same') {
    headline = pick(SAME_HEADLINES)();
    summary = `${memA.nickname}님과 ${memB.nickname}님 모두 ${elemA} 기운의 일간이라, 서로 말이 잘 통하는 자리예요.`;
    evidence = `${memA.nickname}(${glyphA}) · ${memB.nickname}(${glyphB}) : 같은 오행의 일간(비화 관계).`;
  } else if (rel === 'a-ctl-b' || rel === 'b-ctl-a') {
    const leader = rel==='a-ctl-b' ? memA : memB, other = rel==='a-ctl-b' ? memB : memA;
    const leaderGlyph = rel==='a-ctl-b' ? glyphA : glyphB, otherGlyph = rel==='a-ctl-b' ? glyphB : glyphA;
    headline = pick(CTL_HEADLINES)({ leader: leader.nickname });
    summary = `${leader.nickname}님의 기운이 ${other.nickname}님의 기운을 다잡아주는 관계라, 방향이 흐트러질 때 중심을 잡기 좋습니다.`;
    evidence = `${leader.nickname}(${leaderGlyph}) → ${other.nickname}(${otherGlyph}) : 극(剋)하는 관계지만 인접 배치에서는 자극이 되기도 합니다.`;
  } else {
    headline = pick(NONE_HEADLINES)();
    summary = `${memA.nickname}님과 ${memB.nickname}님은 직접적인 상생·상극 관계는 아니지만, 오행 구성이 달라서 자리가 단조롭지 않아요.`;
    evidence = `${memA.nickname}(${glyphA}) · ${memB.nickname}(${glyphB}) : 오행이 달라 대화 결이 다양해지는 조합.`;
  }
  const fillLines = [];
  if (fillsA) fillLines.push(`${memB.nickname}님이 ${weakA} 기운을 갖고 있어 ${memA.nickname}님의 약한 부분(${weakA})을 채워줄 수 있어요.`);
  if (fillsB) fillLines.push(`${memA.nickname}님도 ${weakB} 기운을 갖고 있어 ${memB.nickname}님의 약한 부분(${weakB})을 채워줍니다.`);
  const detail = (`${memA.nickname}님은 오행 중 ${weakA}이 가장 약하고, ${memB.nickname}님은 ${weakB}이 가장 약합니다. ` + fillLines.join(' ')).trim();
  return { headline, summary, evidence, detail };
}

