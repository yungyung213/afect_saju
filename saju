// ================= 결과 렌더링: 2인 케미 =================
function renderPairChemiResult(box, a, b) {
  const emA = ZODIAC_EMOJI[a.saju.day.branchIdx], emB = ZODIAC_EMOJI[b.saju.day.branchIdx];
  const score = compatibilityScore(a, b);
  const exp = buildPairExplanation(a, b);
  const subs = subScores(a, b);

  const head = document.createElement('div');
  head.className = 'resulthead';
  head.innerHTML = `<div class="chemihead">
      <div class="chip"><span class="em">${emA}</span>${a.nickname}</div>
      <span style="color:var(--ink-faint); font-weight:700;">×</span>
      <div class="chip"><span class="em">${emB}</span>${b.nickname}</div>
    </div>`;
  box.appendChild(head);

  const scoreWrap = document.createElement('div');
  scoreWrap.innerHTML = `<div class="scoreBig">${score}</div><div class="scoreLabel">케미 지수</div>`;
  box.appendChild(scoreWrap);

  const card = document.createElement('div');
  card.className = 'resultcard';
  card.innerHTML = `
    <div class="rheadline">${exp.headline}</div>
    <div class="rbody">${exp.summary}</div>
    <div class="rtoggle">왜 ${score}점이지?</div>
    <div class="rdetail">${exp.evidence} ${exp.detail}</div>
  `;
  card.querySelector('.rtoggle').addEventListener('click', function(){
    const d = card.querySelector('.rdetail');
    const open = d.style.display === 'block';
    d.style.display = open ? 'none' : 'block';
    this.textContent = open ? `왜 ${score}점이지?` : '접기';
  });
  box.appendChild(card);

  const subgrid = document.createElement('div');
  subgrid.className = 'subscoregrid';
  const subDefs = [
    { key:'idea', em:'💡', cap:'아이디어 케미', bank:IDEA_LINES },
    { key:'work', em:'💼', cap:'업무 케미', bank:WORK_LINES },
    { key:'lunch', em:'🍚', cap:'점심 케미', bank:LUNCH_LINES },
    { key:'talk', em:'🗣', cap:'대화 케미', bank:TALK_LINES },
    { key:'peace', em:'🧘', cap:'평화 지수', bank:PEACE_LINES },
  ];
  subDefs.forEach(d=>{
    const val = subs[d.key];
    const c = document.createElement('div');
    c.className = 'subscorecard';
    c.innerHTML = `<div class="em">${d.em}</div><div class="cap">${d.cap}</div><div class="val">${val}</div><div class="line">${subLine(d.bank, val)}</div>`;
    subgrid.appendChild(c);
  });
  box.appendChild(subgrid);

  nextActionBar(box, [
    { label:'점심 케미 자세히', onClick: ()=> activatePlay('lunch') },
    { label:'럭키템 보기', onClick: ()=> activatePlay('recharge') },
    { label:'자리도 짜볼까?', onClick: ()=> activatePlay('seating') },
  ]);
}

// ================= 결과 렌더링: 그룹 케미(3명 이상) =================
const ROLE_LABEL = { init:'판 벌리기 담당', ground:'현실 체크 담당', balance:'정리 담당' };
function renderGroupChemiResult(box, list) {
  const head = document.createElement('div');
  head.className = 'resulthead';
  head.innerHTML = `<h2>이 팀의 캐릭터</h2><p class="lede">${list.length}명이 모이면 이렇게 됩니다.</p>`;
  box.appendChild(head);

  const roleGrid = document.createElement('div');
  roleGrid.className = 'roleGrid';
  list.forEach(m=>{
    const elem = STEM_ELEM[m.saju.day.stemIdx];
    const role = ROLE_LABEL[TEMPERAMENT[elem]];
    const row = document.createElement('div');
    row.className = 'roleRow';
    row.innerHTML = `<span class="em">${ZODIAC_EMOJI[m.saju.day.branchIdx]}</span><div><div class="nm">${m.nickname}</div><div class="rl">${role}</div></div>`;
    roleGrid.appendChild(row);
  });
  box.appendChild(roleGrid);

  let pairCount = 0, scoreSum = 0;
  const subSum = { idea:0, work:0, lunch:0, talk:0, peace:0 };
  for (let i=0;i<list.length;i++) for (let j=i+1;j<list.length;j++) {
    scoreSum += compatibilityScore(list[i], list[j]);
    const s = subScores(list[i], list[j]);
    Object.keys(subSum).forEach(k=> subSum[k]+=s[k]);
    pairCount++;
  }
  const avgScore = Math.round(scoreSum / pairCount);
  const scoreWrap = document.createElement('div');
  scoreWrap.innerHTML = `<div class="scoreBig">${avgScore}</div><div class="scoreLabel">팀 밸런스</div>`;
  box.appendChild(scoreWrap);

  const card = document.createElement('div');
  card.className = 'resultcard';
  card.innerHTML = `<div class="rheadline">한 명이 말을 꺼내고, 한 명이 현실을 체크하고, 결국 누군가 정리합니다.</div>
    <div class="rbody">역할이 자연스럽게 나뉘는 조합이라, 회의가 산으로 갈 확률이 낮습니다.</div>`;
  box.appendChild(card);

  const subgrid = document.createElement('div');
  subgrid.className = 'subscoregrid';
  const subDefs = [
    { key:'idea', em:'💡', cap:'아이디어' }, { key:'work', em:'💼', cap:'실행' },
    { key:'talk', em:'🗣', cap:'대화' }, { key:'lunch', em:'🍚', cap:'점심' },
  ];
  subDefs.forEach(d=>{
    const val = Math.round(subSum[d.key]/pairCount);
    const c = document.createElement('div'); c.className = 'subscorecard';
    c.innerHTML = `<div class="em">${d.em}</div><div class="cap">${d.cap}</div><div class="val">${val}</div>`;
    subgrid.appendChild(c);
  });
  box.appendChild(subgrid);

  nextActionBar(box, [
    { label:'점심 케미 보기', onClick: ()=> activatePlay('lunch') },
    { label:'자리도 짜볼까?', onClick: ()=> activatePlay('seating') },
  ]);
}

// ================= 결과 렌더링: 오늘 뭐 먹지? =================
function renderLunchResult(box, list) {
  const head = document.createElement('div');
  head.className = 'resulthead';
  head.innerHTML = `<h2>오늘 뭐 먹지?</h2><p class="lede">사주로 점심 메뉴를 맞춘다는 건 아니고, 그냥 성향 기반 가벼운 참고용입니다.</p>`;
  box.appendChild(head);

  const listWrap = document.createElement('div');
  listWrap.className = 'lunchlist';
  list.forEach(m=>{
    const dom = strongestElem(m.counts);
    const row = document.createElement('div'); row.className = 'lunchrow';
    row.innerHTML = `<span class="em">${ZODIAC_EMOJI[m.saju.day.branchIdx]}</span><div><div class="nm">${m.nickname}</div><div class="tag">${FOOD_TYPE[dom]}</div></div>`;
    listWrap.appendChild(row);
  });
  box.appendChild(listWrap);

  const card = document.createElement('div');
  card.className = 'resultcard';
  if (list.length === 2) {
    const domA = strongestElem(list[0].counts), domB = strongestElem(list[1].counts);
    const val = subScores(list[0], list[1]).lunch;
    const headline = domA === domB
      ? `둘 다 ${FOOD_TYPE[domA]} 앞에서는 꽤 빠르게 합의합니다.`
      : `${list[0].nickname}님은 ${FOOD_TYPE[domA]}, ${list[1].nickname}님은 ${FOOD_TYPE[domB]}. 메뉴판 앞에서 약간의 협상이 필요합니다.`;
    card.innerHTML = `<div class="rheadline">${headline}</div><div class="rbody">점심 케미 ${val}점 — ${subLine(LUNCH_LINES, val)}</div>`;
  } else {
    const doms = list.map(m=>strongestElem(m.counts));
    const uniq = new Set(doms).size;
    const headline = uniq <= 2 ? '취향이 꽤 겹치는 팀이라 메뉴 결정이 빠릅니다.' : '취향이 다양한 팀이라 메뉴 정하는 데 약간의 토론이 필요할 수 있습니다.';
    card.innerHTML = `<div class="rheadline">${headline}</div><div class="rbody">그래도 결국 다 같이 맛있게 먹습니다.</div>`;
  }
  box.appendChild(card);

  nextActionBar(box, [
    { label:'럭키템 보기', onClick: ()=> activatePlay('recharge') },
    { label:'그룹 케미 보기', onClick: ()=> activatePlay('chemi') },
  ]);
}

// ================= 결과 렌더링: 오행 충전소 =================
function renderRechargeResult(box, list) {
  const head = document.createElement('div');
  head.className = 'resulthead';
  head.innerHTML = `<h2>오행 충전소</h2><p class="lede">부족한 오행을 채워주는 가벼운 데스크템 추천입니다.</p>`;
  box.appendChild(head);

  if (list.length === 1) {
    const m = list[0];
    const weak = weakestElem(m.counts);
    const li = LUCKY_ITEMS[weak];
    const card = document.createElement('div'); card.className = 'luckycard';
    card.innerHTML = `<div class="needchips"><span class="luckychip" style="background:${ELEM_BG[weak]};color:${ELEM_COLOR[weak]}">${ELEM_EMOJI[weak]} ${weak} 부족</span></div>
      <div class="itemname">${li.item}</div><div class="itemcopy">${li.copy}</div>`;
    box.appendChild(card);
  } else if (list.length === 2) {
    const weakA = weakestElem(list[0].counts), weakB = weakestElem(list[1].counts);
    const key = comboKey(weakA, weakB);
    const combo = COMBO_ITEMS[key];
    const card = document.createElement('div'); card.className = 'luckycard';
    if (combo) {
      card.innerHTML = `<div class="needchips">
          <span class="luckychip" style="background:${ELEM_BG[weakA]};color:${ELEM_COLOR[weakA]}">${ELEM_EMOJI[weakA]} ${list[0].nickname} · ${weakA} 부족</span>
          <span class="luckychip" style="background:${ELEM_BG[weakB]};color:${ELEM_COLOR[weakB]}">${ELEM_EMOJI[weakB]} ${list[1].nickname} · ${weakB} 부족</span>
        </div>
        <div class="itemname">${combo.item}</div><div class="itemcopy">${combo.copy}</div>`;
    } else {
      const liA = LUCKY_ITEMS[weakA], liB = LUCKY_ITEMS[weakB];
      card.innerHTML = `<div class="itemname">${liA.item} & ${liB.item}</div>
        <div class="itemcopy">${list[0].nickname}님에게는 ${liA.item}, ${list[1].nickname}님에게는 ${liB.item}. 하나씩 나눠 가져도, 책상에 나란히 둬도 괜찮습니다.</div>`;
    }
    box.appendChild(card);
  } else {
    list.forEach(m=>{
      const weak = weakestElem(m.counts);
      const li = LUCKY_ITEMS[weak];
      const card = document.createElement('div'); card.className = 'luckycard'; card.style.marginBottom = '16px';
      card.innerHTML = `<div class="needchips"><span class="luckychip" style="background:${ELEM_BG[weak]};color:${ELEM_COLOR[weak]}">${ZODIAC_EMOJI[m.saju.day.branchIdx]} ${m.nickname} · ${weak} 부족</span></div>
        <div class="itemname">${li.item}</div><div class="itemcopy">${li.copy}</div>`;
      box.appendChild(card);
    });
  }

  nextActionBar(box, [
    { label:'그룹 케미 보기', onClick: ()=> activatePlay('chemi') },
    { label:'자리도 짜볼까?', onClick: ()=> activatePlay('seating') },
  ]);
}
</script>
