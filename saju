function randomJitteredGrid(n, w, h, marginX, marginY) {
  if (n === 0) return [];
  const cols = Math.max(1, Math.round(Math.sqrt(n * (w / h))));
  const rows = Math.ceil(n / cols);
  const cellW = (w - marginX*2) / cols, cellH = (h - marginY*2) / rows;
  const pts = [];
  for (let i = 0; i < n; i++) {
    const col = i % cols, row = Math.floor(i / cols);
    const jx = (Math.random() - 0.5) * cellW * 0.55, jy = (Math.random() - 0.5) * cellH * 0.55;
    const x = marginX + cellW * (col + 0.5) + jx, y = marginY + cellH * (row + 0.5) + jy;
    pts.push({ x: Math.max(marginX, Math.min(w - marginX, x)), y: Math.max(marginY, Math.min(h - marginY, y)) });
  }
  return pts;
}
